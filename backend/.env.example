# =============================================================================
# CV SCREENING AGENT - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your values.
# All sensitive credentials (API keys, SMTP, Twilio) are managed per-user
# via the Settings page in the UI, NOT in this file.

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL connection URL (with asyncpg driver)
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cv_screening_agent

# =============================================================================
# ENCRYPTION
# =============================================================================
# AES-256 encryption key for storing user credentials securely
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANT: Keep this secret and don't change it after deployment!
ENCRYPTION_KEY=

# =============================================================================
# AUTHENTICATION
# =============================================================================
# JWT Secret - IMPORTANT: Change this to a secure random string in production!
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth (optional - leave empty to disable)
# Get credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend URL (for OAuth redirects and CORS)
FRONTEND_URL=http://localhost:5173

# =============================================================================
# CORS (Cross-Origin Resource Sharing)
# =============================================================================
# Comma-separated list of allowed origins
# For local development:
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
# For production, replace with your Vercel domain:
# CORS_ORIGINS=https://your-app.vercel.app

# =============================================================================
# APPLICATION
# =============================================================================
DEBUG=false

# =============================================================================
# USER-MANAGED SETTINGS (BYOK - Bring Your Own Keys)
# =============================================================================
# The following are configured by USERS via the Settings page in the UI,
# NOT in this .env file. Each user provides their own credentials:
#
# 🔑 LLM API KEYS (Settings > API Keys)
#    - OpenAI API key (required for embeddings)
#    - Anthropic API key (optional, for Claude)
#    - Google AI API key (optional, for Gemini)
#
# 📧 EMAIL NOTIFICATIONS (Settings > Notifications > Configure SMTP)
#    - SMTP Host, Port, Username, Password
#    - From Email, From Name
#    - TLS settings
#
# 📱 WHATSAPP NOTIFICATIONS (Settings > Notifications > Configure Twilio)
#    - Twilio Account SID
#    - Twilio Auth Token
#    - WhatsApp From Number
#
# All credentials are encrypted with AES-256 and stored per-user in the database.
