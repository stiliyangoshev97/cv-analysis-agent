
# =============================================================================
# USER API KEY MANAGEMENT (BYOK - Bring Your Own Key)
# =============================================================================
# API keys are managed per-user via the Settings page (/settings)
# Users MUST configure their own OpenAI, Anthropic, and/or Gemini keys after login
# Keys are stored encrypted in the database (user_api_keys table)
#
# NO FALLBACK TO ENVIRONMENT VARIABLES - Users must set their keys in the UI
#
# Required for CV processing:
#   - OpenAI API key (for embeddings - MANDATORY)
#   - At least one LLM API key (OpenAI, Anthropic, or Gemini)

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL connection URL (with asyncpg driver)
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cv_screening_agent

# =============================================================================
# ENCRYPTION
# =============================================================================
# AES-256 encryption key for API keys stored in database
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# =============================================================================
# AUTHENTICATION
# =============================================================================
# JWT Secret - IMPORTANT: Change this to a secure random string in production!
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth (optional)
# Get credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:5173

# =============================================================================
# LLM CONFIGURATION (Model defaults only - no API keys here!)
# =============================================================================
# Users provide their own API keys via Settings page.
# These settings only control default model selection.

# Default LLM Provider when user hasn't set preference: "anthropic", "openai", or "gemini"
DEFAULT_LLM_PROVIDER=anthropic

# Default models per provider (users can override in Settings)
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_MODEL=gpt-4o
GEMINI_MODEL=gemini-1.5-flash

# LLM Parameters (applies to all providers)
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# =============================================================================
# EMBEDDINGS CONFIGURATION (OpenAI Only)
# =============================================================================
# Embeddings MUST use OpenAI for pgvector consistency.
# All CVs must have embeddings with the same dimensions.
# Users configure their OpenAI key via /api/settings/api-keys
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# =============================================================================
# EMAIL NOTIFICATIONS (SMTP)
# =============================================================================
# SMTP server configuration for sending email notifications
# Common providers:
#   - Gmail: smtp.gmail.com (port 587, use App Password)
#   - Outlook: smtp-mail.outlook.com (port 587)
#   - SendGrid: smtp.sendgrid.net (port 587)
#   - Mailgun: smtp.mailgun.org (port 587)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=CV Screening Agent
SMTP_USE_TLS=true

# =============================================================================
# WHATSAPP NOTIFICATIONS (TWILIO)
# =============================================================================
# Twilio configuration for WhatsApp notifications
# Get credentials at: https://console.twilio.com/
# WhatsApp setup: https://www.twilio.com/docs/whatsapp/quickstart
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# =============================================================================
# APPLICATION
# =============================================================================
DEBUG=false
