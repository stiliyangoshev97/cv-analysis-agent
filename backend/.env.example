
# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL connection URL (with asyncpg driver)
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cv_screening_agent

# =============================================================================
# ENCRYPTION
# =============================================================================
# AES-256 encryption key for API keys stored in database
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# =============================================================================
# AUTHENTICATION
# =============================================================================
# JWT Secret - IMPORTANT: Change this to a secure random string in production!
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth (optional)
# Get credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:5173

# =============================================================================
# AI PROVIDERS - SYSTEM DEFAULTS (Optional)
# =============================================================================
# These are system-level API keys used when users don't provide their own.
# In BYOK mode, users provide their own keys via /api/settings/api-keys.
#
# IMPORTANT: Users MUST configure OpenAI API key for embeddings.
# LLM provider (Claude/GPT/Gemini) is user's choice.

# Default LLM Provider: "anthropic", "openai", or "gemini"
# This is the fallback when user hasn't configured their preference.
DEFAULT_LLM_PROVIDER=anthropic

# Anthropic (Claude) - System key (optional, users can use BYOK)
# Get API key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI - System key (optional, users can use BYOK)
# Get API key at: https://platform.openai.com/api-keys
# NOTE: OpenAI is REQUIRED for embeddings (user must configure in settings)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Google (Gemini) - System key (optional, users can use BYOK)
# Get API key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# LLM Parameters (applies to all providers)
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# =============================================================================
# EMBEDDINGS CONFIGURATION (OpenAI Only)
# =============================================================================
# Embeddings MUST use OpenAI for pgvector consistency.
# All CVs must have embeddings with the same dimensions.
# Users configure their OpenAI key via /api/settings/api-keys
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# =============================================================================
# EMAIL NOTIFICATIONS (SMTP)
# =============================================================================
# SMTP server configuration for sending email notifications
# Common providers:
#   - Gmail: smtp.gmail.com (port 587, use App Password)
#   - Outlook: smtp-mail.outlook.com (port 587)
#   - SendGrid: smtp.sendgrid.net (port 587)
#   - Mailgun: smtp.mailgun.org (port 587)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=CV Screening Agent
SMTP_USE_TLS=true

# =============================================================================
# WHATSAPP NOTIFICATIONS (TWILIO)
# =============================================================================
# Twilio configuration for WhatsApp notifications
# Get credentials at: https://console.twilio.com/
# WhatsApp setup: https://www.twilio.com/docs/whatsapp/quickstart
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# =============================================================================
# APPLICATION
# =============================================================================
DEBUG=false
